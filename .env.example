# ============================================================
# Homely — Environment Configuration
# Copy file này thành .env và chỉnh giá trị cho môi trường của bạn:
#   cp .env.example .env
# ============================================================

# ── Database (SQL Server) ───────────────────────────────────
DB_NAME=homely_db
DB_PORT=1433
# Yêu cầu độ phức tạp của SQL Server: tối thiểu 8 ký tự, có chữ hoa/thường/số/ký tự đặc biệt.
DB_PASSWORD=YourStrong!Passw0rd

# ── Backend ──────────────────────────────────────────────────
BACKEND_PORT=8080
JWT_SECRET=change-this-to-a-random-64-char-string

# AI Provider cho module ai-design: mock (không tốn phí) | replicate (thật, cần key)
# Xem docs/decisions/ADR-0003-ai-integration-approach.md
AI_PROVIDER=mock

# Chỉ cần khi AI_PROVIDER=replicate. Lấy key tại https://replicate.com/account/api-tokens
# (mỗi lần generate tốn phí thật, ~$0.02-0.05/ảnh — xem docs/services/ai-design-service.md).
REPLICATE_API_KEY=

# ── Frontend ─────────────────────────────────────────────────
FRONTEND_PORT=80
