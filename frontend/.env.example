# Bật đăng nhập giả để xem các màn hình protected mà không cần backend/database.
VITE_MOCK_AUTH=true

# Chỉ cần khi dùng API thật ở host khác.
# VITE_API_BASE_URL=http://localhost:8080/api/v1# URL gốc của backend API. Khi chạy qua Nginx (Docker), để trống hoặc "/api/v1" vì Nginx proxy sẵn.
# Khi chạy dev riêng (npm run dev) không qua Nginx, để "http://localhost:8080/api/v1".
VITE_API_BASE_URL=/api/v1
