# Để đăng nhập thật và gọi API backend khi chạy npm run dev.
# Dùng npm run dev:mock nếu chỉ muốn xem UI, không gọi API có xác thực.
VITE_MOCK_AUTH=false

# Chỉ cần khi dùng API thật ở host khác.
# VITE_API_BASE_URL=http://localhost:8080/api/v1# URL gốc của backend API. Khi chạy qua Nginx (Docker), để trống hoặc "/api/v1" vì Nginx proxy sẵn.
# Khi chạy dev riêng (npm run dev) không qua Nginx, để "http://localhost:8080/api/v1".
VITE_API_BASE_URL=/api/v1

# AI Chatbox — giữ key phía backend, không đặt tiền tố VITE_ vì biến VITE_ được gửi ra trình duyệt.
# Đặt GEMINI_API_KEY trong terminal chạy backend và khởi động lại backend để bật chat Gemini.
# Lấy key tại: https://aistudio.google.com/app/apikey
